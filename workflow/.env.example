# First run uses deterministic mock agents, so no API key is needed.
WORKFLOW_MOCK_LLM=1
WORKFLOW_LLM_PROVIDER=siliconflow
WORKFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
WORKFLOW_LLM_TIMEOUT=120
WORKFLOW_LLM_MAX_RETRIES=1
WORKFLOW_API_PORT=8001
WORKFLOW_DASHBOARD_PORT=8501

# To use a real model, set WORKFLOW_MOCK_LLM=0 and fill SILICONFLOW_API_KEY.
